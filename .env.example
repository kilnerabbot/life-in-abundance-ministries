# Supabase — copy to .env.local (git-ignored) and fill from your Supabase
# project: Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — SERVER ONLY, never prefixed NEXT_PUBLIC. Used later to let
# the public site read published CMS content past RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
